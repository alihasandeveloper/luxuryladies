# WordPress / WooCommerce Headless Backend Configuration
WP_BACKEND_URL=https://your-wordpress-site.com
WP_CK=ck_your_woocommerce_consumer_key_here
WP_CS=cs_your_woocommerce_consumer_secret_here

# Local Demo Mode (Set to true to use rich local demo data instead of live WordPress)
ENABLE_DEMO=true
NEXT_PUBLIC_ENABLE_DEMO=true
